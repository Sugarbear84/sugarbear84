# ===========================================
# Base Trading Agent — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git.
# ===========================================

# --- Agent Wallet ---
# Leave blank on first run. The agent will generate a wallet
# and print the private key. Paste it here, then fund the
# address with testnet ETH.
AGENT_PRIVATE_KEY=

# --- Base Sepolia RPC ---
# Option 1: Alchemy (recommended) — free tier is fine
#   Sign up at https://www.alchemy.com
#   Create an app on "Base Sepolia" network
#   Copy the HTTPS URL
#
# Option 2: Public RPC (rate-limited, fine for testing)
#   https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org

# --- LLM API Key ---
# Get from https://console.anthropic.com
# The agent uses Claude to make trading decisions.
ANTHROPIC_API_KEY=

# --- Optional ---
# Basescan API key for tx verification
# Get from https://basescan.org/apis
BASESCAN_API_KEY=
